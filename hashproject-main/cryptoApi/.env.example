# Copy to .env and fill in. .env is gitignored; never commit real values.
# These replace credentials that were previously hardcoded in the source,
# so the old values are public and must be rotated at each provider.

# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Off by default. Never turn this on for a deployment reachable from outside.
DJANGO_DEBUG=1

# Comma separated. Defaults to localhost,127.0.0.1 when unset.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins allowed to call the API from a browser.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DJANGO_CORS_ALLOW_ALL=0

# Third-party credentials used by the api app.
COINMARKETCAP_API_KEY=
SCRAPERAPI_API_KEY=
COINLORE_SESSION_COOKIE=

# Celery broker/result backend.
REDIS_SERVER=redis://localhost:6379/0

# Seconds before an outbound scrape is abandoned.
OUTBOUND_REQUEST_TIMEOUT=20

# Runs uploaded JavaScript to time it. Leave off: the upload endpoint is
# unauthenticated, so enabling this on a reachable host hands anyone remote
# code execution. Only for an isolated, trusted research machine.
DOMINANCE_ALLOW_JS_EXECUTION=0

# Set to 1 once the site is served over TLS: turns on HTTPS redirect, HSTS
# and secure session/CSRF cookies. Leave off for plain-HTTP local runs.
DJANGO_SECURE=0
